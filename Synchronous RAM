`timescale 1ns / 1ps

module ram (
    input clk,
    input we,            
    input [3:0] addr,    
    input [7:0] din,     
    output reg [7:0] dout 
);
    reg [7:0] memory [0:15];

    always @(posedge clk) begin
        if (we) begin
            memory[addr] <= din;   
        end else begin
            dout <= memory[addr];  
        end
    end
endmodule
`timescale 1ns / 1ps

module ram_tb;
    reg clk, we;
    reg [3:0] addr;
    reg [7:0] din;
    wire [7:0] dout;

    ram uut (.clk(clk), .we(we), .addr(addr), .din(din), .dout(dout));

    always #5 clk = ~clk; // 10ns Clock

    initial begin
        clk = 0; we = 0; addr = 0; din = 0;
        $display("Time\t clk\t we\t addr\t din\t dout\t Action");
        $monitor("%0t\t %b\t %b\t %d\t %d\t %d\t %s", $time, clk, we, addr, din, dout, (we?"WRITING":"READING"));

        #10 we = 1; addr = 4'd5; din = 8'd120; // Write 120 to addr 5
        #10 we = 1; addr = 4'd10; din = 8'd255; // Write 255 to addr 10
        
        #10 we = 0; addr = 4'd5;  // Read from addr 5
        #10 we = 0; addr = 4'd10; // Read from addr 10
        #10 we = 0; addr = 4'd0;  // Read uninitialized memory
        
        #20 $finish;
    end
endmodule
