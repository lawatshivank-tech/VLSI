`timescale 1ns / 1ps

module alu (
    input  [7:0] A,
    input  [7:0] B,
    input  [2:0] ALU_Sel,
    output reg [7:0] ALU_Out,
    output reg CarryOut
);

    always @(*) begin
        CarryOut = 1'b0; // Default carry
        case(ALU_Sel)
            3'b000: {CarryOut, ALU_Out} = A + B;       // Addition
            3'b001: ALU_Out = A - B;                   // Subtraction
            3'b010: ALU_Out = A & B;                   // Bitwise AND
            3'b011: ALU_Out = A | B;                   // Bitwise OR
            3'b100: ALU_Out = ~A;                      // Bitwise NOT (A)
            default: ALU_Out = 8'h00; 
        endcase
    end
endmodule
`timescale 1ns / 1ps

module alu_tb;
    reg [7:0] A, B;
    reg [2:0] ALU_Sel;
    wire [7:0] ALU_Out;
    wire CarryOut;

    alu uut (.A(A), .B(B), .ALU_Sel(ALU_Sel), .ALU_Out(ALU_Out), .CarryOut(CarryOut));

    initial begin
        $display("Time\t A\t B\t Sel\t Out\t C_out\t Operation");
        $monitor("%0t\t %d\t %d\t %b\t %d\t %b\t %s", $time, A, B, ALU_Sel, ALU_Out, CarryOut, get_op(ALU_Sel));

        A = 8'd15; B = 8'd10; 
        ALU_Sel = 3'b000; #10; // ADD
        ALU_Sel = 3'b001; #10; // SUB
        ALU_Sel = 3'b010; #10; // AND
        ALU_Sel = 3'b011; #10; // OR
        ALU_Sel = 3'b100; #10; // NOT
        A = 8'd250; B = 8'd10; ALU_Sel = 3'b000; #10; // ADD with Carry
        $finish;
    end

    function [8*5:1] get_op(input [2:0] sel);
        case(sel)
            3'b000: get_op = "ADD  ";
            3'b001: get_op = "SUB  ";
            3'b010: get_op = "AND  ";
            3'b011: get_op = "OR   ";
            3'b100: get_op = "NOT A";
            default:get_op = "UNKWN";
        endcase
    endfunction
endmodule
