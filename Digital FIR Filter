`timescale 1ns / 1ps

module fir_filter (
    input clk,
    input reset,
    input [7:0] x_in,
    output reg [15:0] y_out
);
    // Tap Coefficients: 1, 2, 2, 1
    wire [7:0] b0 = 8'd1; wire [7:0] b1 = 8'd2;
    wire [7:0] b2 = 8'd2; wire [7:0] b3 = 8'd1;

    reg [7:0] x1, x2, x3;

    always @(posedge clk or posedge reset) begin
        if (reset) begin
            x1 <= 0; x2 <= 0; x3 <= 0; y_out <= 0;
        end else begin
            x1 <= x_in; x2 <= x1; x3 <= x2;
            y_out <= (x_in * b0) + (x1 * b1) + (x2 * b2) + (x3 * b3);
        end
    end
endmodule
`timescale 1ns / 1ps

module fir_tb;
    reg clk, reset;
    reg [7:0] x_in;
    wire [15:0] y_out;

    fir_filter uut (.clk(clk), .reset(reset), .x_in(x_in), .y_out(y_out));

    always #5 clk = ~clk;

    initial begin
        clk = 0; reset = 1; x_in = 0;
        #10 reset = 0;

        $display("Time\t x_in\t y_out");
        $monitor("%0t\t %d\t %d", $time, x_in, y_out);

        // Impulse Response Test
        #10 x_in = 8'd10; 
        #10 x_in = 8'd0; #10 x_in = 8'd0; #10 x_in = 8'd0; #10 x_in = 8'd0;  
        
        // Step Response Test
        #10 x_in = 8'd5; #10 x_in = 8'd5; #10 x_in = 8'd5; #10 x_in = 8'd5;
        
        #20 $finish;
    end
endmodule
